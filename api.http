@baseUrl = http://localhost:8080

### Health
GET {{baseUrl}}/health

### Create a class
# @name createClass
POST {{baseUrl}}/classes
Content-Type: application/json

{ "name": "Class 6 - Morning Shift", "totalSeats": 120 }

### List classes with seat counts
GET {{baseUrl}}/classes

### Get one class (run "Create a class" first)
GET {{baseUrl}}/classes/{{createClass.response.body.id}}

### 400 VALIDATION_ERROR: empty name
POST {{baseUrl}}/classes
Content-Type: application/json

{ "name": "   ", "totalSeats": 120 }

### 400 VALIDATION_ERROR: seats must be positive
POST {{baseUrl}}/classes
Content-Type: application/json

{ "name": "Class 7 - Day Shift", "totalSeats": 0 }

### 400 INVALID_JSON: malformed body
POST {{baseUrl}}/classes
Content-Type: application/json

{ "name": "Class 7 - Day Shift",

### 415 UNSUPPORTED_MEDIA_TYPE: body is not JSON
POST {{baseUrl}}/classes
Content-Type: text/plain

name=Class 7

### 404 CLASS_NOT_FOUND: unknown class
GET {{baseUrl}}/classes/00000000-0000-0000-0000-000000000000

### 404 NOT_FOUND: unknown route
GET {{baseUrl}}/does-not-exist

### 405 METHOD_NOT_ALLOWED
DELETE {{baseUrl}}/classes

# ----------------------------------------------------------------------------
# Holds. Run "Create a class" first. Each new run of that request gives a fresh
# class, so "Apply" succeeds again for the same student.
# ----------------------------------------------------------------------------

### 201 Apply (seat hold)
# @name createHold
POST {{baseUrl}}/classes/{{createClass.response.body.id}}/holds
X-Student-Id: 20152691234567890

### 400 MISSING_STUDENT_ID: no header
POST {{baseUrl}}/classes/{{createClass.response.body.id}}/holds

### 400 INVALID_STUDENT_ID: 16 digits instead of 17
POST {{baseUrl}}/classes/{{createClass.response.body.id}}/holds
X-Student-Id: 2015269123456789

### 409 ALREADY_APPLIED: same student twice (run after "Apply")
POST {{baseUrl}}/classes/{{createClass.response.body.id}}/holds
X-Student-Id: 20152691234567890

### Create a one-seat class for the "class full" case
# @name oneSeatClass
POST {{baseUrl}}/classes
Content-Type: application/json

{ "name": "Class 9 - Day Shift", "totalSeats": 1 }

### 201 Take the only seat
POST {{baseUrl}}/classes/{{oneSeatClass.response.body.id}}/holds
X-Student-Id: 20150000000000001

### 409 CLASS_FULL: a different student, no seats left
POST {{baseUrl}}/classes/{{oneSeatClass.response.body.id}}/holds
X-Student-Id: 20150000000000002
